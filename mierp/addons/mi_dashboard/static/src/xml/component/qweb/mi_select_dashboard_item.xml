        t-att-data-id="id" 
        t-att-data-name="name"
        t-att-data-write_date="write_date"
        t-att-data-theme_name="theme_name">
        <div class="mi_title" t-esc="name">Select Dashboard</div>
        <div class="mi_subtitle my-1"><span class="material-icons mr-1">topic</span> <t t-esc="category">No Category</t></div>
        <div class="mi_subtitle">
            <t t-esc="write_date"/>
        </div>
        <div class="mi_edit_dashboard_item mi_select_item_icon" title="Edit Dashboard">
            <span class="material-icons" t-esc="'edit'"/>
        </div>
    </div>
</template>