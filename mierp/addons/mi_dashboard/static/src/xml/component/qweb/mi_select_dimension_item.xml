<template>
    <div t-name="miCurrentDimensionItem" class="mi_current_dimension_item mi_item mi_btn mi_btn_wlb mi_w100 mi_rd8 active" t-att-data-id="id" t-att-data-name="name">
        <span t-if="field_type != 'date' &amp;&amp; field_type != 'datetime'" class="material-icons-outlined mi_btn_icon_left">
            <t t-esc="field_icon"/>
        </span>
        <!-- Date Format -->
        <div t-if="field_type == 'date' || field_type == 'datetime'" class="mi_dropdown mi_block_left dropdown mi_inline mi_inherit">
            <button class="mi_btn mi_m0 mi_py0 mi_pl0 mi_btn_wlp dropdown-toggle mi_inherit mi_no_border" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <t t-esc="field_format"/>
            </button>
            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                <a class="dropdown-item mi_select_format" data-format="day" t-att-data-dimension="dimension_id">Date</a>
                <a class="dropdown-item mi_select_format" data-format="week" t-att-data-dimension="dimension_id">Week</a>
                <a class="dropdown-item mi_select_format" data-format="month" t-att-data-dimension="dimension_id">Month</a>
                <a class="dropdown-item mi_select_format" data-format="quarter" t-att-data-dimension="dimension_id">Quarter</a>
                <a class="dropdown-item mi_select_format" data-format="year" t-att-data-dimension="dimension_id">Year</a>
            </div>
        </div>
        <span class="mi_text mi_block_left" t-att-title="name">
            <t t-esc="name"/>
        </span>
        <span t-att-data-id="id" t-att-data-dimension="dimension_id" class="mi_remove_dimension_item material-icons mi_btn_icon_right mi_hover_highlight" t-esc="'highlight_off'"/>
        <div style="clear:both"/>
    </div>
    <div t-name="miSelectDimensionItem" class="mi_select_dimension_item mi_item mi_btn mi_btn_wlb mi_w100 mi_rd" t-att-data-id="id" t-att-data-name="name">
        <span class="material-icons-outlined mi_btn_icon_left">
            <t t-esc="field_icon"/>
        </span>
        <span class="mi_text mi_block_left" t-att-title="name">
            <t t-esc="name"/>
        </span>
        <div style="clear:both"/>
    </div>
</template>