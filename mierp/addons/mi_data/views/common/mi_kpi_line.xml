<?xml version="1.0" encoding="UTF-8"?>
<mierp>
    <data>
        <record model="ir.actions.act_window" id="mi_kpi_line_action">
            <field name="name">Key Performance Indicator Details</field>
            <field name="path">mi-kpi-line</field>
            <field name="res_model">mi.kpi.line</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Tree view for the menuitem -->
        <record id="mi_kpi_line_tree" model="ir.ui.view">
            <field name="name">mi.kpi.line.tree</field>
            <field name="model">mi.kpi.line</field>
            <field name="arch" type="xml">
                <list editable='bottom'>
                    <field name="kpi_id" readonly="1"/>
                    <field name="name" readonly="1"/>
                    <field name="period_id" readonly="1"/>
                    <field name="date" readonly="1"/>
                    <field name="interval" readonly="1"/>
                    <field name="target"/>
                    <field name="value" readonly="1"/>
                    <field name="achievement" readonly="1"/>
                </list>
            </field>
        </record>
        
    </data>
</mierp>