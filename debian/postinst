#!/bin/sh

set -e

mierp_CONFIGURATION_FILE=/etc/mierp/mierp.conf
mierp_GROUP="mierp"
mierp_DATA_DIR=/var/lib/mierp
mierp_LOG_DIR=/var/log/mierp
mierp_USER="mierp"
GSFONTS_DIR=/usr/share/fonts/type1/gsfonts

case "${1}" in
    configure)
        if ! getent passwd | grep -q "^mierp:"; then
            adduser --system --home $mierp_DATA_DIR --quiet --group $mierp_USER
            # Data dir
            chown $mierp_USER:$mierp_GROUP $mierp_DATA_DIR
        fi
        # Register "$mierp_USER" as a postgres user with "Create DB" role attribute
        su - postgres -c "createuser -d -R -S $mierp_USER" 2> /dev/null || true
        # Configuration file
        chown $mierp_USER:$mierp_GROUP $mierp_CONFIGURATION_FILE
        chmod 0640 $mierp_CONFIGURATION_FILE
        # Log
        mkdir -p $mierp_LOG_DIR
        chown $mierp_USER:$mierp_GROUP $mierp_LOG_DIR
        chmod 0750 $mierp_LOG_DIR
        	# work around https://bugs.debian.org/1059326

        if ! [ -e ${GSFONTS_DIR}/n021003l.pfb ] ; then
            if ! [ -d ${GSFONTS_DIR} ] ; then
                mkdir ${GSFONTS_DIR}
                touch ${GSFONTS_DIR}/.created-by-mierp-package
            fi
            ln -s /usr/share/fonts/X11/Type1/C059-Roman.pfb ${GSFONTS_DIR}/n021003l.pfb
        fi
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
